---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="About Us – Open Farms WNY"
			description="Learn about Open Farms WNY's mission, values, and the people dedicated to growing community in Western New York."
		/>
	</head>
	<body>
		<Header />
		<main>

			<section class="page-hero">
				<div class="container">
					<span class="section-tag">Our Story</span>
					<h1>About Open Farms WNY</h1>
					<p>A community rooted in the land, growing something bigger than food.</p>
				</div>
			</section>

			<!-- Mission -->
			<section class="section">
				<div class="container about-grid">
					<div class="about-text">
						<span class="section-tag">Our Mission</span>
						<h2>Why We Farm Together</h2>
						<p>
							Open Farms WNY exists to reconnect people with the land and with each other. We
							believe farming is more than growing food — it's a way to build community, develop
							purpose, and find healing.
						</p>
						<p>
							Our working farm in Western New York is a place where volunteers, students, families,
							and individuals seeking therapeutic connection can come together around the shared
							rhythms of farm life.
						</p>
						<p>
							We are a 501(c)(3) nonprofit organization, funded by donations, grants, and the
							generous time of our volunteer community.
						</p>
					</div>
					<div class="about-image">
						<img
							src="/blog-placeholder-2.jpg"
							alt="Volunteers working together at Open Farms WNY"
							class="about-img"
						/>
					</div>
				</div>
			</section>

			<!-- Values -->
			<section class="section bg-off-white">
				<div class="container">
					<div class="section-header">
						<span class="section-tag">What We Believe</span>
						<h2>Our Core Values</h2>
					</div>
					<div class="values-grid">
						<div class="value-card">
							<div class="value-icon">🌱</div>
							<h3>Community First</h3>
							<p>
								Every decision we make starts with people. The farm exists to serve the community —
								not the other way around.
							</p>
						</div>
						<div class="value-card">
							<div class="value-icon">🤝</div>
							<h3>Radical Welcome</h3>
							<p>
								Everyone belongs here. We actively create space for people of all backgrounds,
								abilities, and experience levels.
							</p>
						</div>
						<div class="value-card">
							<div class="value-icon">🌍</div>
							<h3>Stewardship</h3>
							<p>
								We care for the land, the animals, and the people in our community with the same
								intention and respect.
							</p>
						</div>
						<div class="value-card">
							<div class="value-icon">✨</div>
							<h3>Purpose Through Work</h3>
							<p>
								We believe meaningful work in nature has real healing power. The farm gives people
								something real to show up for.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- What We Grow -->
			<section class="section">
				<div class="container">
					<div class="about-grid">
						<div class="about-image">
							<img
								src="/blog-placeholder-3.jpg"
								alt="Animals at Open Farms WNY"
								class="about-img"
							/>
						</div>
						<div class="about-text">
							<span class="section-tag">The Farm</span>
							<h2>Animals, Gardens & More</h2>
							<p>
								Our working farm is home to a variety of animals — including goats, chickens, and
								other beloved residents — as well as vegetable gardens, raised beds, and fields that
								produce food for the community.
							</p>
							<p>
								Everything that happens on the farm involves our volunteers and program participants.
								From morning feeding rounds to planting days to harvest festivals, the work is shared
								and the rewards are too.
							</p>
							<a href="/programs" class="btn btn-outline-green">See Our Programs</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Team -->
			<section class="section bg-off-white">
				<div class="container">
					<div class="section-header">
						<span class="section-tag">The People</span>
						<h2>Our Team</h2>
						<p>
							Our farm is run by a dedicated group of staff, board members, and long-term volunteers
							who make it all happen.
						</p>
					</div>
					<div class="team-placeholder">
						<p>
							Meet the team — full bios coming soon. In the meantime,
							<a href="/contact">reach out and say hello</a>.
						</p>
					</div>
				</div>
			</section>

			<!-- CTA -->
			<section class="cta-section">
				<div class="container cta-inner">
					<div class="cta-text">
						<h2>Be part of the story.</h2>
						<p>There's always room for one more pair of hands at Open Farms WNY.</p>
					</div>
					<div class="cta-actions">
						<a href="/get-involved#volunteer" class="btn btn-secondary">Volunteer With Us</a>
						<a href="/contact" class="btn btn-outline-green">Get in Touch</a>
					</div>
				</div>
			</section>

		</main>
		<Footer />
	</body>
</html>

<style>
	.about-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
	}

	.about-img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
	}

	.about-text h2 {
		margin-bottom: 1.25rem;
	}

	.about-text .btn {
		margin-top: 0.5rem;
	}

	.values-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}

	.value-card {
		background: var(--white);
		padding: 2rem 1.5rem;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
		text-align: center;
	}

	.value-icon {
		font-size: 2.5rem;
		margin-bottom: 1rem;
		line-height: 1;
	}

	.value-card h3 {
		font-size: 1.05rem;
		margin-bottom: 0.75rem;
	}

	.value-card p {
		font-size: 0.88rem;
	}

	.team-placeholder {
		text-align: center;
		padding: 3rem;
		background: var(--white);
		border-radius: var(--radius-lg);
		border: 2px dashed var(--border);
	}

	.team-placeholder p {
		font-size: 1.05rem;
		color: var(--text-mid);
		margin: 0;
	}

	@media (max-width: 960px) {
		.values-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {
		.about-grid {
			grid-template-columns: 1fr;
		}

		.about-image {
			display: none;
		}
	}

	@media (max-width: 480px) {
		.values-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
