---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const schedule = [
	{
		day: 'Saturday',
		time: '8:00 AM – 12:00 PM',
		session: 'Morning Work Session',
		note: 'Year-round',
		type: 'regular',
		desc: 'Our most popular session. Come for the full four hours or drop in for part of it. All tasks are guided.',
	},
	{
		day: 'Thursday',
		time: '5:00 PM – 8:00 PM',
		session: 'Evening Volunteer Night',
		note: 'Spring – Fall only',
		type: 'regular',
		desc: 'A great option if Saturday mornings don\'t work for you. Lighter work, great community.',
	},
	{
		day: 'First Sunday of the Month',
		time: '10:00 AM – 2:00 PM',
		session: 'Family Farm Day',
		note: 'Monthly',
		type: 'special',
		desc: 'An open event for the whole family. Animals, activities, produce giveaways, and community.',
	},
];

const faqs = [
	{
		q: 'Do I need to sign up in advance?',
		a: 'For Saturday and Thursday sessions, no sign-up is required — just show up! Family Farm Days are drop-in as well. For school groups and special programs, please contact us in advance.',
	},
	{
		q: 'What should I wear and bring?',
		a: 'Wear clothes you don\'t mind getting dirty and closed-toe shoes (no sandals on the farm). Bring a water bottle, work gloves if you have them, and sun protection in warmer months. We\'ll provide the rest.',
	},
	{
		q: 'Is the farm accessible?',
		a: 'We are working to improve accessibility across the farm. Some areas are on uneven terrain. Please contact us in advance if you have specific accessibility needs and we\'ll do our best to accommodate you.',
	},
	{
		q: 'Can I bring my kids?',
		a: 'Absolutely! Children are welcome at all sessions with a parent or guardian. Family Farm Days are especially designed for families. Children under 14 must be accompanied by an adult.',
	},
	{
		q: 'Is it free to volunteer?',
		a: 'Yes — volunteering at Open Farms WNY is always free. We are a nonprofit and donations are welcome but never required.',
	},
	{
		q: 'What if the weather is bad?',
		a: 'Farms run in most weather! Sessions are only canceled for severe weather (lightning, extreme cold, etc.). Check our social media or newsletter for day-of updates.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Visit the Farm – Open Farms WNY"
			description="Plan your visit to Open Farms WNY. Find our schedule, directions, and everything you need to know before you arrive."
		/>
	</head>
	<body>
		<Header />
		<main>

			<section class="page-hero">
				<div class="container">
					<span class="section-tag">Come See Us</span>
					<h1>Visit the Farm</h1>
					<p>Find our schedule, get directions, and learn what to expect on your first visit.</p>
				</div>
			</section>

			<!-- Schedule -->
			<section class="section">
				<div class="container">
					<div class="section-header">
						<span class="section-tag">When We're Open</span>
						<h2>Farm Schedule</h2>
						<p>No experience needed. Just show up, and we'll put you to work.</p>
					</div>
					<div class="schedule-list">
						{
							schedule.map((s) => (
								<div class={`sched-row ${s.type === 'special' ? 'sched-special' : ''}`}>
									<div class="sched-day">
										<strong>{s.day}</strong>
										<span class="sched-note">{s.note}</span>
									</div>
									<div class="sched-middle">
										<span class="sched-session">{s.session}</span>
										<span class="sched-time">{s.time}</span>
									</div>
									<p class="sched-desc">{s.desc}</p>
								</div>
							))
						}
					</div>
					<div class="schedule-note-box">
						<strong>🌧 Weather cancellations:</strong> Sessions are rarely canceled but may be
						modified for safety. Follow us on social media or sign up for our newsletter for
						day-of updates.
					</div>
				</div>
			</section>

			<!-- Location -->
			<section class="section bg-off-white">
				<div class="container location-grid">
					<div class="location-info">
						<span class="section-tag">Getting Here</span>
						<h2>Location & Directions</h2>
						<p>We're located in Western New York. Exact address and driving directions are available upon registration or by contacting us.</p>

						<div class="contact-blocks">
							<div class="contact-block">
								<span class="contact-icon">📍</span>
								<div>
									<strong>Address</strong>
									<p>Western New York (exact address provided upon registration)</p>
								</div>
							</div>
							<div class="contact-block">
								<span class="contact-icon">📧</span>
								<div>
									<strong>Email Us</strong>
									<p><a href="mailto:info@openfarmsny.org">info@openfarmsny.org</a></p>
								</div>
							</div>
							<div class="contact-block">
								<span class="contact-icon">🅿️</span>
								<div>
									<strong>Parking</strong>
									<p>Free on-site parking available. Accessible spaces near the entrance.</p>
								</div>
							</div>
						</div>

						<a href="/contact" class="btn btn-secondary" style="margin-top: 1.5rem;">Get Directions</a>
					</div>
					<div class="map-placeholder">
						<div class="map-box">
							<span class="map-icon">🗺️</span>
							<p>Map coming soon</p>
							<a href="/contact" class="btn btn-outline-green btn-sm">Contact Us for Directions</a>
						</div>
					</div>
				</div>
			</section>

			<!-- FAQ -->
			<section class="section">
				<div class="container">
					<div class="section-header">
						<span class="section-tag">Before You Come</span>
						<h2>Frequently Asked Questions</h2>
					</div>
					<div class="faq-list">
						{
							faqs.map((faq) => (
								<details class="faq-item">
									<summary class="faq-q">{faq.q}</summary>
									<p class="faq-a">{faq.a}</p>
								</details>
							))
						}
					</div>
				</div>
			</section>

			<!-- CTA -->
			<section class="cta-section">
				<div class="container cta-inner">
					<div class="cta-text">
						<h2>Ready for your first visit?</h2>
						<p>Saturday mornings are a great place to start. Show up, meet the team, and dig in.</p>
					</div>
					<div class="cta-actions">
						<a href="/get-involved#volunteer" class="btn btn-secondary">Sign Up to Volunteer</a>
						<a href="/contact" class="btn btn-outline-green">Ask Us Anything</a>
					</div>
				</div>
			</section>

		</main>
		<Footer />
	</body>
</html>

<style>
	/* Schedule */
	.schedule-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 860px;
		margin: 0 auto;
	}

	.sched-row {
		background: var(--white);
		border-radius: var(--radius-lg);
		padding: 1.75rem 2rem;
		box-shadow: var(--shadow-sm);
		border-left: 5px solid var(--green-light);
		display: grid;
		grid-template-columns: 200px 220px 1fr;
		gap: 1.5rem;
		align-items: start;
	}

	.sched-special {
		border-left-color: var(--yellow);
	}

	.sched-day strong {
		display: block;
		font-size: 1.05rem;
		font-weight: 900;
		color: var(--green);
		margin-bottom: 0.3rem;
	}

	.sched-special .sched-day strong {
		color: var(--yellow-dark);
	}

	.sched-note {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 700;
		background: var(--green-pale);
		color: var(--green);
		padding: 0.2em 0.7em;
		border-radius: var(--radius-full);
	}

	.sched-special .sched-note {
		background: #fff8e1;
		color: var(--yellow-dark);
	}

	.sched-session {
		display: block;
		font-weight: 800;
		color: var(--text);
		margin-bottom: 0.3rem;
	}

	.sched-time {
		font-size: 0.9rem;
		color: var(--text-mid);
	}

	.sched-desc {
		font-size: 0.9rem;
		color: var(--text-mid);
		margin: 0;
		line-height: 1.6;
	}

	.schedule-note-box {
		max-width: 860px;
		margin: 1.5rem auto 0;
		background: var(--yellow-pale);
		border: 1px solid #ffe082;
		border-radius: var(--radius);
		padding: 1rem 1.5rem;
		font-size: 0.9rem;
		color: var(--text-mid);
	}

	/* Location */
	.location-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: start;
	}

	.contact-blocks {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-top: 1.5rem;
	}

	.contact-block {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
	}

	.contact-icon {
		font-size: 1.5rem;
		flex-shrink: 0;
		line-height: 1.3;
	}

	.contact-block strong {
		display: block;
		font-weight: 800;
		color: var(--text);
		margin-bottom: 0.2rem;
	}

	.contact-block p {
		font-size: 0.92rem;
		margin: 0;
	}

	.map-box {
		height: 320px;
		background: var(--green-pale);
		border-radius: var(--radius-lg);
		border: 2px dashed var(--border);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		text-align: center;
	}

	.map-icon {
		font-size: 3rem;
	}

	.map-box p {
		color: var(--text-light);
		font-weight: 700;
		margin: 0;
	}

	/* FAQ */
	.faq-list {
		max-width: 760px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.faq-item {
		background: var(--white);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
	}

	.faq-q {
		list-style: none;
		padding: 1.25rem 1.5rem;
		font-weight: 800;
		font-size: 1rem;
		cursor: pointer;
		display: flex;
		justify-content: space-between;
		align-items: center;
		color: var(--text);
		transition: background var(--transition);
	}

	.faq-q::-webkit-details-marker {
		display: none;
	}

	.faq-q::after {
		content: '+';
		font-size: 1.4rem;
		font-weight: 400;
		color: var(--green);
		flex-shrink: 0;
		transition: transform var(--transition);
	}

	.faq-item[open] .faq-q {
		background: var(--green-pale);
		color: var(--green-dark);
	}

	.faq-item[open] .faq-q::after {
		transform: rotate(45deg);
	}

	.faq-a {
		padding: 1rem 1.5rem 1.25rem;
		font-size: 0.95rem;
		color: var(--text-mid);
		margin: 0;
		border-top: 1px solid var(--border);
	}

	@media (max-width: 900px) {
		.sched-row {
			grid-template-columns: 1fr 1fr;
		}

		.sched-desc {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 768px) {
		.location-grid {
			grid-template-columns: 1fr;
		}

		.sched-row {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}
	}
</style>
